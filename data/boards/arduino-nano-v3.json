  "snippets": [
    {
      "title": "Drive a pin, and read one with a pull-up",
      "toolchain": "avr-libc",
      "lang": "c",
      "code": "#include <avr/io.h>\n\n/* Three registers per port. DDR picks direction, PORT writes the\n   output latch, PIN reads the physical pin. */\n\nDDRB  |=  (1 << PB5);          /* PB5 = Arduino D13 = output */\nPORTB |=  (1 << PB5);          /* high */\nPORTB &= ~(1 << PB5);          /* low  */\nPINB  |=  (1 << PB5);          /* writing PIN toggles the output */\n\nDDRD  &= ~(1 << PD2);          /* PD2 = D2 = input */\nPORTD |=  (1 << PD2);          /* PORT on an input enables the pull-up */\n\nif (!(PIND & (1 << PD2))) {    /* switch to ground reads 0 when pressed */\n}",
      "gotcha": "On an input pin, PORT is the pull-up enable, not an output value. Forget it and a floating pin reads whatever the nearest mains cable is doing."
    }
  ]
