  "circuit": {
    "title": "Minimum circuit to run",
    "parts": [
      {
        "part": "Clock oscillator",
        "symbol": "osc",
        "from": "6",
        "to": "GND",
        "required": true,
        "why": "A single-phase 5 V clock. The NMOS part also has a minimum clock speed, so it cannot be single-stepped slowly."
      },
      {
        "part": "330 Ohm",
        "symbol": "res",
        "from": "6",
        "to": "VCC",
        "required": false,
        "why": "The NMOS Z80 wants the clock pulled close to VCC. CMOS parts, the Z84C00, do not need this."
      },
      {
        "part": "10 kOhm",
        "symbol": "res",
        "from": "26",
        "to": "VCC",
        "required": true,
        "why": "Reset pull-up, with a capacitor to ground for a power-on reset of at least three clocks."
      },
      {
        "part": "10 uF",
        "symbol": "cap",
        "from": "26",
        "to": "GND",
        "required": true,
        "why": "Holds RESET low while the supply comes up."
      },
      {
        "part": "10 kOhm",
        "symbol": "res",
        "from": "16",
        "to": "VCC",
        "required": true,
        "why": "An unused interrupt input must be held high or you take interrupts that never happened."
      },
      {
        "part": "10 kOhm",
        "symbol": "res",
        "from": "17",
        "to": "VCC",
        "required": true,
        "why": "NMI is edge triggered and cannot be masked, so a floating pin is worse than a floating INT."
      },
      {
        "part": "10 kOhm",
        "symbol": "res",
        "from": "24",
        "to": "VCC",
        "required": true,
        "why": "WAIT held low stretches every machine cycle forever. The bus simply stops."
      },
      {
        "part": "10 kOhm",
        "symbol": "res",
        "from": "25",
        "to": "VCC",
        "required": true,
        "why": "BUSREQ held low floats the address and data buses and hands them to nobody."
      },
      {
        "part": "100 nF",
        "symbol": "cap",
        "from": "11",
        "to": "GND",
        "required": true,
        "why": "Supply decoupling at the pin."
      }
    ],
    "note": "Qualify memory and I/O decoding with MREQ (19) and IORQ (20). The Z80 puts the refresh address on A0-A6 during the second half of every M1 cycle, so raw address lines are not a valid chip select."
  }
