  "slug": "arduino-mega-2560",
  "name": "Arduino Mega 2560 (main headers)",
  "shortName": "Mega 2560",
  "vendor": "Arduino",
  "category": "mcu-board",
  "summary": "ATmega2560 with 54 digital pins, 16 analog inputs and four hardware serial ports. These are the Uno-compatible side headers; D22 to D53 live on the separate double-row header at the end of the board.",
  "logic": "5 V",
  "package": "Mega shield form factor, 101.5 x 53.3 mm",
  "layout": {
    "kind": "board",
    "numbering": "explicit",
    "rows": 28,
    "sideLabels": [
      "Power + Analog headers",
      "Digital + Communication headers"
    ]
