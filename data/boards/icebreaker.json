{
  "slug": "icebreaker",
  "name": "1BitSquared iCEBreaker v1.x",
  "shortName": "iCEBreaker",
  "vendor": "1BitSquared",
  "category": "mcu-board",
  "summary": "A Lattice iCE40UP5K FPGA board with an FT2232H programmer, 16 MB of QSPI flash and three PMOD ports. It was designed for teaching the open source Yosys and nextpnr flow, and that is still what most people buy it for.",
  "logic": "3.3 V",
  "package": "Main board with two 2x6 PMOD host headers (PMOD1A, PMOD1B), a 2x4 RGB LED and supply header, a 1x7 flash header and two 5 V AUX pins, plus a snap-off section on a third 2x6 PMOD (PMOD2). 2.54 mm pitch.",
  "chipPinLabel": "FPGA pin",
  "layout": {
    "kind": "board",
    "numbering": "explicit",
    "rows": 28,
    "sideLabels": [
      "PMOD pins 1-6, odd pins of the other headers",
      "PMOD pins 7-12, even pins of the other headers"
    ]
  },
  "keywords": [
    "icebreaker",
    "ice40",
    "ice40up5k",
    "up5k",
    "ultraplus",
    "fpga",
    "lattice",
