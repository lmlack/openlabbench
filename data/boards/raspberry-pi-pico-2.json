  "snippets": [
    {
      "title": "Drive a pin and read one",
      "toolchain": "Pico SDK",
      "lang": "c",
      "code": "#include \"pico/stdlib.h\"\n\n#define LED 25                 /* on-board LED, not on the header */\n\ngpio_init(LED);\ngpio_set_dir(LED, GPIO_OUT);\ngpio_put(LED, 1);\n\ngpio_init(15);\ngpio_set_dir(15, GPIO_IN);\ngpio_pull_up(15);              /* pulls are off until you ask */\n\nif (!gpio_get(15)) {\n}",
      "gotcha": "gpio_init resets the pin to SIO and clears both pulls, so call it before set_dir, not after. On a Pico W the LED is on the wireless chip and GPIO 25 does nothing."
    }
  ]
