  "snippets": [
    {
      "title": "Use the quasi-bidirectional ports",
      "toolchain": "SDCC or Keil C51",
      "lang": "c",
      "code": "#include <reg52.h>\n\n/* There is no direction register. Write 1 to a bit to release it\n   so it can be read, write 0 to pull it low. */\n\nP2 = 0x00;                     /* drive all of Port 2 low  */\nP2 = 0xFF;                     /* release it, weakly high  */\n\nP1 = 0xFF;                     /* release Port 1 to read it */\nif ((P1 & 0x01) == 0) {        /* P1.0 pulled to ground     */\n}\n\nsbit LED = P2 ^ 0;             /* single bit access */\nLED = 0;",
      "gotcha": "Port 0 has no internal pull-ups at all, so it cannot drive a logic high without an external resistor on every bit. Ports 1, 2 and 3 have weak ones and can."
    }
