  "category": "sbc",
  "summary": "The power, serial, I2C, SPI and analog side of the BeagleBone Black. The seven ADC channels take 1.8 V at most.",
  "logic": "3.3 V / 1.8 V ADC",
  "package": "2x23 2.54 mm (P9)",
  "layout": {
    "kind": "header",
    "numbering": "zigzag",
    "rows": 23,
    "sideLabels": [
