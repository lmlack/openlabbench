  "snippets": [
    {
      "title": "Blink the on-board LED on PC13",
      "toolchain": "CMSIS, no HAL",
      "lang": "c",
      "code": "#include \"stm32f4xx.h\"\n\n/* F4 is a different GPIO block from the F1. Clock gating moved to\n   AHB1, and the four-bit CRL/CRH scheme is gone. */\nRCC->AHB1ENR |= RCC_AHB1ENR_GPIOCEN;\n\n/* MODER is 2 bits per pin: 01 = general purpose output. */\nGPIOC->MODER &= ~(3u << (13 * 2));\nGPIOC->MODER |=  (1u << (13 * 2));\n\nGPIOC->OTYPER  &= ~(1u << 13);        /* push-pull */\nGPIOC->OSPEEDR &= ~(3u << (13 * 2));  /* low speed is fine for an LED */\n\nGPIOC->BSRR = GPIO_BSRR_BR13;         /* LED on, active low */\nGPIOC->BSRR = GPIO_BSRR_BS13;         /* LED off */",
      "gotcha": "Code written for an F1 Blue Pill will not compile here. CRL and CRH do not exist on the F4, the clock enable moved from APB2ENR to AHB1ENR, and MODER is two bits per pin instead of four."
    }
  ]
