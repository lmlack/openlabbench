  "snippets": [
    {
      "title": "Set up the ports, and stop them being analog",
      "toolchain": "XC8",
      "lang": "c",
      "code": "#include <xc.h>\n\n/* Port A and Port E come up ANALOG. Until this runs, a digital\n   read on those pins returns 0 no matter what you wired. */\nADCON1 = 0x06;                 /* PCFG = 0110: all digital */\n\nTRISB  = 0x00;                 /* 0 = output, the opposite of AVR's DDR */\nPORTB  = 0xFF;\n\nTRISA  = 0xFF;                 /* 1 = input */\nif (PORTAbits.RA0 == 0) {\n}\n\n/* RA4 is open drain. It can sink but never source, so an LED\n   to ground will not light from this pin. */",
      "gotcha": "TRIS is inverted against AVR's DDR: 0 means output here. And Port A defaults to analog, which is the single most common first-project failure on this chip."
    }
  ],
