{
  "name": "openlabbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run data && next dev",
    "data": "npm run validate && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-cheatsheets.ts",
    "prebuild": "npm run data",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-data.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
